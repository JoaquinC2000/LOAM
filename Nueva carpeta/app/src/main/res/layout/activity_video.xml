<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/vistaPreviaCamara"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#66000000"
        android:padding="12dp">

        <ImageView
            android:id="@+id/botonVolverGrabacion"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/volver_atras"
            android:contentDescription="Volver"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/white"
            android:padding="4dp"/>

        <TextView
            android:id="@+id/textoTituloGrabacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Video"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/indicadorGrabando"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="70dp"
        android:background="@drawable/bg_indicador_grabando"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <View
            android:id="@+id/puntoRojoGrabando"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_punto_rojo" />

        <TextView
            android:id="@+id/textoTiempoGrabando"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="00:00"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/textoEstadoGrabacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="130dp"
        android:background="@drawable/bg_indicador_grabando"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:visibility="gone" />

    <View
        android:id="@+id/botonGrabar"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_boton_grabar_circular"
        android:clickable="true"
        android:focusable="true" />

</FrameLayout>