<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="horizontal"
    android:padding="14dp"
    tools:background="@drawable/bg_tarjeta_menu_roja">

    <TextView
        android:id="@+id/iconoPaso"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_icono_paso"
        android:gravity="center"
        android:textSize="20sp"
        tools:text="⚠️" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tituloPaso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_principal"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Evacuar Inmediatamente" />

        <TextView
            android:id="@+id/descripcionPaso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp"
            tools:text="No intentes recoger pertenencias." />

    </LinearLayout>

</LinearLayout>