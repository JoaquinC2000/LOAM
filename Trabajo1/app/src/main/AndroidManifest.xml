<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--Para el clima-->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--Para el mapa-->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--Para la cámara-->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--Para la alerta-->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Trabajo1"
        android:name=".AlertaCatastrofeApp">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".EmergenciaActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".UbicacionActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".MultimediaActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".GrabacionVideoActivity"
            android:exported="false"
            android:parentActivityName=".MultimediaActivity" />

        <activity
            android:name=".GrabacionAudioActivity"
            android:exported="false"
            android:parentActivityName=".MultimediaActivity" />

        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".GuiaActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"/>

            <!-- INNOVACION - RADIO -->
        <activity
            android:name=".RadioActivity"
            android:exported="false"
            android:parentActivityName=".MultimediaActivity" />


    </application>

</manifest>